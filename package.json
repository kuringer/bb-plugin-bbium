{
  "name": "bb-plugin-bbium",
  "version": "0.1.0",
  "description": "Vimium-style keys for bb: f for click hints, j/k and d/u to scroll, i for the composer.",
  "type": "module",
  "license": "MIT",
  "author": "Andrej Kostal (https://github.com/kuringer)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuringer/bb-plugin-bbium.git"
  },
  "keywords": [
    "bb-plugin",
    "vimium",
    "vim",
    "keyboard",
    "hints",
    "shortcuts"
  ],
  "scripts": {
    "test": "node --test hints.test.ts keys.test.ts settings.test.ts",
    "typecheck": "tsc -p .",
    "build": "bb plugin build .",
    "verify": "npm run typecheck && npm test && npm run build",
    "e2e": "node e2e/smoke.mjs"
  },
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15"
  },
  "bb": {
    "name": "Bbium",
    "description": "Vimium-style keys: f to click by label, j/k and d/u to scroll, i for the composer.",
    "branding": {
      "icon": "./icons/bbium.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "hono": "^4.13.13",
    "playwright-core": "^1.64.0",
    "typescript": "^5.7.0"
  }
}
